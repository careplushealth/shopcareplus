# ============================================================
# CarePlus Health - Environment Configuration Template
# Copy this file to `.env.local` and fill in your actual values.
# NEVER commit your `.env` or `.env.local` file to version control!
# ============================================================

# Neon Cloud Serverless PostgreSQL Database Connection
# Pooled connection string (for serverless queries & API routes)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-your-branch-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Unpooled direct connection string (optional / migrations)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-your-branch.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Active Neon Database Branch (e.g. production, preview, dev)
NEON_BRANCH=production

# Admin Portal Master Authentication Password
# Choose a strong password for administrative access to the pharmacy portal
ADMIN_PASSWORD="your-strong-admin-password-here"

# Stripe Payment Gateway Credentials
# Browser-accessible publishable key (prefixed with VITE_)
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_your_publishable_key_here"

# Server-side only Stripe secret key (NEVER prefix with VITE_)
STRIPE_SECRET_KEY="sk_live_your_secret_key_here"

# Optional: Stripe Webhook Signing Secret (from Stripe Workbench)
# STRIPE_WEBHOOK_SECRET="whsec_your_webhook_signing_secret_here"
